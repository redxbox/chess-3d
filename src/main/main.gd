func _ready() -> void:
	# Seed the global RNG. Without this, every "random" AI choice and every
	# archive id is identical on each launch.
	randomize()
	var configured_version := str(ProjectSettings.get_setting("application/config/version", ""))
	_app_version = configured_version if configured_version != "" else APP_VERSION_FALLBACK
	_load_piece_theme()
	_load_board_theme()
	_setup_environment()
	_setup_piece_materials()
	decor_root.name = "EnvironmentDetails"
	coordinates_root.name = "BoardCoordinates"
	board.add_child(decor_root)
	board.add_child(coordinates_root)
	_create_board()
	pieces_root.name = "Pieces"
	highlights_root.name = "Highlights"
	board.add_child(highlights_root)
	board.add_child(pieces_root)
	_has_resumable_game = _load_autosave()
	if not _has_resumable_game:
		game.reset()
	_create_pieces()
	_create_ui()
	_create_audio()
	_apply_graphics_quality()
	_apply_accessibility()
	get_viewport().size_changed.connect(_apply_safe_area)
	_apply_safe_area()
	_update_status()
	_show_main_menu()


func _process(delta: float) -> void:
	_fps_accumulator += delta
	if _fps_accumulator >= 1.0:
		_fps_accumulator = 0.0
		_monitor_performance()
	var clock_expired := false
	if clock_enabled and game.result == "":
		if game.turn == ChessRules.WHITE:
			white_time = maxf(0.0, white_time - delta)
			if white_time <= 0.0:
				game.result = "Black wins on time"
		else:
			black_time = maxf(0.0, black_time - delta)
			if black_time <= 0.0:
				game.result = "White wins on time"
		clock_expired = game.result != ""
	if clock_expired:
		# Runs exactly once, on the frame the clock ran out.
		_update_status()
		_show_game_over_if_needed()
		_save_autosave()
	_update_clock_label()
	_autosave_accumulator += delta
	if _autosave_accumulator >= 5.0:
		_autosave_accumulator = 0.0
		_save_autosave()


func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_PAUSED or what == NOTIFICATION_WM_CLOSE_REQUEST:
		_save_autosave()
		if is_instance_valid(_music_player): _music_player.stream_paused = true
	elif what == NOTIFICATION_APPLICATION_RESUMED:
		if is_instance_valid(_music_player) and music_enabled: _music_player.stream_paused = false


func _setup_environment() -> void:
	# ACES + sRGB. Everything here is renderer level and is set exactly once, so
	# it applies to every GFX preset (AUTO / LOW / MEDIUM / HIGH) alike; the only
	# thing _apply_graphics_quality() varies per preset is shadow casting, MSAA
	# and screen-space AA, never the exposure or the tonemapper.
	var environment := Environment.new()
	environment.background_mode = Environment.BG_COLOR
	environment.background_color = Color("3b2e42")
	environment.tonemap_mode = Environment.TONE_MAPPER_ACES
	# Exposure is the master fader for the whole frame, and it is set against the
	# light rig below rather than in isolation. The brief's light energies plus
	# the pale Carrara and alabaster albedoes at exposure 0.80 pushed 85% of the
	# classic light squares past 1.0, and a clipped square is a flat white slab
	# with no veining and no shading left anywhere on it.
	environment.tonemap_exposure = 0.66
	var sky_material := ProceduralSkyMaterial.new()
	# A dark studio with a warm horizon. The horizon band is what the brass and
	# gold inlays reflect; with the old near-black sky every gold collar read as mud.
	sky_material.sky_top_color = Color("3d4550")
	sky_material.sky_horizon_color = Color("a0958a")
	sky_material.ground_bottom_color = Color("14100f")
	sky_material.ground_horizon_color = Color("4d4239")
	var studio_sky := Sky.new()
	studio_sky.radiance_size = Sky.RADIANCE_SIZE_64
	studio_sky.sky_material = sky_material
	environment.sky = studio_sky
	# Both the ambient term and the specular term come from the sky rather than
	# from a flat colour. A colour-driven ambient is what made the gold and the
	# polished wood read as dull plastic: there was nothing for them to reflect,
	# so the only highlights on a metallic surface were the three directional
	# lights. The sky gives every metal edge a real environment to mirror.
	environment.reflected_light_source = Environment.REFLECTION_SOURCE_SKY
	environment.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	environment.ambient_light_sky_contribution = 1.0
	# Scales the sky-driven ambient. Directional lights are additive on top of
	# it, so the sum of key + fill + rim is what decides whether a pale surface
	# survives. The ambient is raised rather than cut whenever the frame is
	# brought down, because it is the only term that reaches the surfaces the
	# key light cannot see: at 0.35 every table step sitting in the board's own
	# shadow collapsed to pure black, which is exactly the void the brief wants
	# gone.
	environment.ambient_light_energy = 0.45
	# A three-point studio rig, so both sets read as solid volume at once. The
	# old single key light left the camera-facing side of every dark piece in
	# its own shadow, which is why the black set used to collapse into
	# silhouettes while the white set went chalky.
	#
	# Key: front-left and above, warm, and the only light that casts.
	#
	# 0.78 was calibrated against the old piece silhouettes. The turned stems and
	# the slimmer pawn cast less shadow than what they replaced, and with the
	# fill's grazing shadows doing less work the pale squares sat the rest of the
	# way into the clip and came back as flat #ffffff with no shading left on
	# them. 0.73 puts them back just under.
	$KeyLight.light_energy = 0.73
	$KeyLight.light_color = Color(1.0, 0.96, 0.90)
	$KeyLight.rotation_degrees = Vector3(-48, -32, 0)
	# Contact-tight shadows. The normal bias is deliberately small: a large one
	# displaces the shadow lookup a long way along the surface normal, and a
	# flat face can end up sampling the wrong part of the shadow map and drop
	# into shadow for no visible reason.
	$KeyLight.shadow_enabled = true
	$KeyLight.shadow_bias = 0.01
	$KeyLight.shadow_normal_bias = 0.25
	$KeyLight.shadow_blur = 1.2
	# A wide shadow reach. At 22 the far ranks sat at the edge of the shadow map's
	# orthographic frustum and their contact shadows were not drawn at all.
	$KeyLight.directional_shadow_max_distance = 40.0
	# Fill: soft, front-right and low, no shadow. This is what actually lights
	# the side of a piece the camera can see.
	$FillLight.light_energy = 0.28
	$FillLight.light_color = Color(0.88, 0.91, 0.98)
	$FillLight.rotation_degrees = Vector3(-60, 45, 0)
	$FillLight.shadow_enabled = false
	# Rim: behind rank 8, grazing, and bright enough to sculpt. It skims the
	# crown, neck and shoulders of a dark body and leaves a specular edge along
	# its silhouette, so an obsidian piece reads as an object instead of a hole
	# in the picture.
	$RimLight.rotation_degrees = Vector3(-35, 160, 0)
	$RimLight.light_color = Color(0.90, 0.93, 1.0)
	# 0.25, not the 0.50 this rig was balanced at. The rim skims the crown, the
	# neck and the shoulders from behind, and at 0.50 its grazing lobe on a dark
	# body with any specular at all was enough to clip the rook's crown and the
	# pawns' collars to white rings. 0.25 still leaves a specular edge along the
	# silhouette, which is the whole point of a rim, without the blowout.
	$RimLight.light_energy = 0.25
	$RimLight.shadow_enabled = false
	# Bounce: a fourth, upward-facing light that stands in for the light the pale
	# board throws back up. It is what keeps the underside of a piece from going
	# to black, and that matters most for the knight: its jaw overhangs its own
	# neck, so the whole underside of the head is a crevice the three top lights
	# cannot reach, and at full shadow it read as a hole through the piece. Warm
	# and dim on purpose - it must lift the shadow, not add a second key.
	$BounceLight.light_energy = 0.16
	$BounceLight.light_color = Color(0.97, 0.90, 0.80)
	$BounceLight.rotation_degrees = Vector3(68, 12, 0)
	$BounceLight.shadow_enabled = false
	# Bloom is off. With it on, the Compatibility renderer lifted the whole
	# frame: the background went from the intended #2a1f2e to a flat #be82c6 and
	# the pale squares lost every bit of contrast. The gold inlays read fine on
	# specular alone, and nothing here glows.
	environment.glow_enabled = false
	# SSAO, SSR and depth of field are Forward+ / Mobile features; in Godot 4 depth
	# of field is not an Environment property at all but a CameraAttributesPractical
	# on the camera. Guarding on the renderer keeps startup clean and leaves the
	# settings in place for the day the project moves off Compatibility.
	if str(ProjectSettings.get_setting("rendering/renderer/rendering_method")) != "gl_compatibility":
		environment.ssao_enabled = true
		environment.ssao_radius = 0.85
		environment.ssao_intensity = 1.5
		environment.ssao_power = 1.6
		environment.ssr_enabled = true
		environment.ssr_max_steps = 24
		var camera_attributes := CameraAttributesPractical.new()
		camera_attributes.dof_blur_far_enabled = true
		camera_attributes.dof_blur_far_distance = 13.0
		camera_attributes.dof_blur_far_transition = 5.0
		camera_attributes.dof_blur_amount = 0.10
		camera.attributes = camera_attributes
	$WorldEnvironment.environment = environment


## ---------------------------------------------------------------------------
## Procedural surface maps
##
## Every board and piece material is driven by textures generated once at
## startup into the shared mesh cache. Generating them keeps the APK free of
## binary texture assets while still giving marble veining, wood grain and a
## matching normal map, which is what makes the surfaces read as material
## rather than flat colour under the key light.
## ---------------------------------------------------------------------------

var _surface_maps: Dictionary = {}


func _surface_map(kind: String) -> Texture2D:
	if _surface_maps.has(kind):
		return _surface_maps[kind]
	var texture: Texture2D = null
	match kind:
		"marble": texture = _surface_texture(SURFACE_MARBLE)
		"marble_normal": texture = _normal_map(_surface_heights(SURFACE_MARBLE))
		"walnut": texture = _surface_texture(SURFACE_WALNUT)
		"walnut_normal": texture = _normal_map(_surface_heights(SURFACE_WALNUT))
		"rosewood": texture = _surface_texture(SURFACE_ROSEWOOD)
		"rosewood_normal": texture = _normal_map(_surface_heights(SURFACE_ROSEWOOD))
	_surface_maps[kind] = texture
	return texture


func _map_size() -> int:
	return 64 if _effective_graphics_quality() == "low" else 128


## One shared FBM noise field per surface. TYPE_SIMPLEX_SMOOTH with
## FRACTAL_FBM gives organic blotching; the old generators drove `abs(sin(x + y))`,
## whose zero crossings land on parallel 45-degree lines and read as striped
## fabric rather than as stone or wood. Two decorrelated fields are blended, one
## broad and one fine, so no direction is favoured and the diagonal repeat is
## gone. The amplitude is deliberately tiny - the shade band is only 6% wide - so
## the squares stay smooth and polished with a hint of figure rather than a
## pattern. The albedo map and the height map are built from the same seeded
## field, so the veining and the bump it produces always agree.
func _surface_noise(seed_value: int, frequency: float, octaves: int = 2) -> FastNoiseLite:
	var noise := FastNoiseLite.new()
	noise.seed = seed_value
	noise.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	noise.fractal_type = FastNoiseLite.FRACTAL_FBM
	noise.fractal_octaves = octaves
	noise.frequency = frequency
	return noise


## The two decorrelated fields for one surface: a broad one and a fine one. They
## are built once per map rather than once per pixel, because a FastNoiseLite is
## not free to allocate and these maps are 128x128.
##
## The frequencies are in "features across the texture", because the maps are
## sampled on a 0..1 grid and FastNoiseLite's own frequency multiplies that grid.
## Four octaves were tried first and rejected: each octave doubles the frequency,
## so the top one landed under four texels and every square on the far side of
## the board - which is where a tile is only nine pixels wide on screen - sampled
## it one texel to one pixel. That is exactly the banding the brief asks to have
## gone. Two octaves keeps the finest detail near thirty texels, where the
## mip chain the materials filter with has something to fall back on, and the
## shade band is held to four percent so the squares stay smooth and polished
## with a hint of figure rather than a pattern.
func _surface_fields(seed_value: int, fine_seed: int) -> Array:
	return [_surface_noise(seed_value, 0.8), _surface_noise(fine_seed, 2.0)]


## The shared softness field for one surface, sampled on a unit grid.
func _surface_field(fields: Array, u: float, v: float) -> float:
	var broad: FastNoiseLite = fields[0]
	var fine: FastNoiseLite = fields[1]
	return broad.get_noise_2d(u, v) * 0.7 + fine.get_noise_2d(u, v) * 0.3


## The three apron surfaces. They are the same noise, the same shade band and the
## same tint arithmetic; only the seeds and the tint differ, so they are three
## entries and two functions rather than three copies of eighty lines. Wood is
## neutral and marble is a hair warm in red and cool in blue, which is the whole
## of the difference the board materials see.
const SURFACE_MARBLE := {"seed": 8123, "fine": 4409, "tint": Color(1.0, 0.99, 0.965)}
const SURFACE_WALNUT := {"seed": 4471, "fine": 2107, "tint": Color(1.0, 1.0, 1.0)}
const SURFACE_ROSEWOOD := {"seed": 9902, "fine": 5511, "tint": Color(1.0, 1.0, 1.0)}
## The map is centred on 0.93 with a band five percent wide. The band is the six
## percent the brief allows, and the centre is not arbitrary: the accepted
## renders were measured with a marble map whose mean sat at 0.93, and at 0.975
## the pale squares sat just far enough past the clip point that they came back
## as flat #ffffff with no shading left on them anywhere.
const SURFACE_SHADE_CENTRE := 0.93
const SURFACE_SHADE_BAND := 0.025
const SURFACE_SHADE_RANGE := Vector2(0.905, 0.955)


## One apron albedo, from one surface description.
func _surface_texture(surface: Dictionary) -> ImageTexture:
	var size := _map_size()
	var fields := _surface_fields(surface.seed, surface.fine)
	var tint: Color = surface.tint
	var image := Image.create(size, size, true, Image.FORMAT_RGB8)
	for y in size:
		for x in size:
			var u := float(x) / float(size)
			var v := float(y) / float(size)
			var shade := clampf(SURFACE_SHADE_CENTRE + SURFACE_SHADE_BAND * _surface_field(fields, u, v),
				SURFACE_SHADE_RANGE.x, SURFACE_SHADE_RANGE.y)
			image.set_pixel(x, y, Color(shade, shade, shade, 1.0) * tint)
	# Image.create reserves the mip chain but does not fill it, and an unfilled
	# chain uploads as black - so the far ranks, which are the squares that
	# sample the higher levels, came back banded. Generating them here is what
	# makes the linear-with-mipmaps filter the materials ask for actually work.
	image.generate_mipmaps()
	return ImageTexture.create_from_image(image)


## The height field for one surface, sampled from the same seeds as its albedo
## so the veining and the relief it produces always agree.
func _surface_heights(surface: Dictionary) -> PackedFloat32Array:
	var size := _map_size()
	var fields := _surface_fields(surface.seed, surface.fine)
	var heights := PackedFloat32Array()
	heights.resize(size * size)
	for y in size:
		for x in size:
			heights[y * size + x] = _surface_field(fields,
				float(x) / float(size), float(y) / float(size)) * 0.35
	return heights


## The bump map for one surface, built from the same field as its albedo so the
## veining and the relief it produces always agree.
##
## The strength is a z divisor, so a larger number is a stronger bump. It is 2.6,
## which is where the accepted renders were measured: the field is calm, so the
## slope is small and the normal stays within a few degrees of straight up. The
## point of the map at this amplitude is not relief, it is the last three percent
## of shading that keeps a broad flat square from reading as a painted decal -
## taking it off entirely pushed the pale squares the rest of the way into the
## clip.
func _normal_map(heights: PackedFloat32Array) -> ImageTexture:
	var size := _map_size()
	var image := Image.create(size, size, true, Image.FORMAT_RGB8)
	var strength := 2.6
	for y in size:
		for x in size:
			var left: float = heights[y * size + ((x - 1 + size) % size)]
			var right: float = heights[y * size + ((x + 1) % size)]
			var up: float = heights[((y - 1 + size) % size) * size + x]
			var down: float = heights[((y + 1) % size) * size + x]
			var normal := Vector3(left - right, up - down, 1.0 / strength).normalized()
			image.set_pixel(x, y, Color(normal.x * 0.5 + 0.5, normal.y * 0.5 + 0.5, normal.z * 0.5 + 0.5, 1.0))
	image.generate_mipmaps()
	return ImageTexture.create_from_image(image)


func _setup_piece_materials() -> void:
	# The three sets are balanced against each other rather than tuned alone,
	# because the board is only ever seen with one of them on it:
	#   medieval - carved boxwood against walnut, antique gold rules
	#   court    - pale celadon against deep nephrite, gold rules
	#   classic  - polished alabaster against satin obsidian, silver trim
	# Every colour, roughness and metallic below comes from PIECE_THEMES; the two
	# spot values that used to be hard-coded here are now per theme, so a polish
	# change cannot silently apply to the wooden set.
	var palette: Dictionary = PIECE_THEMES.get(piece_theme, PIECE_THEMES["classic"])
	var body_light: Color = palette.light
	var body_dark: Color = palette.dark
	# The trim colour is shared by the piece collars and the board inlay. At the
	# old 0.82 / 0.83 albedo with metallic_specular 0.50 every collar and coronet
	# band clipped to a white ring wherever the light caught it, which is why the
	# black pieces on the h-file side had bright white hoops round their bases
	# while the same pieces on the a-file side read as dark metal.
	var accent: Color = palette.accent
	var carve := _piece_carve_map()
	# White pieces: polished but never a mirror. roughness 0.24 with a low
	# metallic_specular keeps the pale body mostly diffuse, which is what stops
	# it climbing to 1.0 and clipping to flat white under ACES - and a clipped
	# surface has no shading and no shadow gradient left anywhere on it to show
	# the carving. Pure white is never a white-piece albedo.
	_piece_ivory_material = _luxury_piece_material(body_light, palette.light_roughness, 0.05, false, false, 0.06, null, carve, 0.25, 0.40, 0.20, true)
	# Black pieces: never pure black. A satin body with a real clearcoat lobe is
	# what gives the camera-facing side of a dark piece a highlight, so it reads
	# as a solid object beside the white set instead of a silhouette. The
	# specular term is back at its default here because a dark albedo cannot
	# clip the way a pale one does.
	# The dark body's specular term is 0.35 rather than the 0.50 default. At 0.50
	# the sky reflection and the rim light's grazing lobe rode on top of the
	# diffuse and the crown, the collars and the coronet bands all clipped to
	# white rings wherever the light caught them.
	_piece_obsidian_material = _luxury_piece_material(body_dark, palette.dark_roughness, 0.12, false, false, 0.35, null, carve, 0.25, 0.40, 0.20, true)
	# The trim has to be readable on the side of the piece the camera actually
	# sees, and that decides its metallicity. The key light sits at yaw -32,
	# i.e. it arrives from -X, so every face pointing at the camera (+X) gets
	# N.L = -0.355 from the key, -0.280 from the rim, and only +0.354 from the
	# 0.28 fill. That is why the collar tori, the coronet balls and the inlay
	# band came back as black blobs: at metallic 0.90 the material is pure
	# specular, so an unlit face has no diffuse to fall back on and only
	# reflects the dark sky-top.
	#
	# Dropping metallic to 0.40 gives it a real diffuse base - 0.60 * 0.60 -
	# which the fill and the 0.45 sky ambient can reach, so the trim reads as
	# machined brass instead of a hole. Roughness 0.42 is
	# the board inlay's value and keeps the lobe wide. metallic_specular goes to
	# 0.30 to pay for the lost metallicity: the resulting F0 is 0.079, a fifth
	# of the 0.41 that clipped the collars to white rings at 0.82 / 0.50 with a
	# clearcoat lobe on top, and the lobe is twice as wide, so the peak is far
	# lower. The albedo is untouched.
	# 0.24 rather than 0.30 of metallic_specular. The trim is the brightest thing
	# on a dark piece, and on a phone the specular lobe on a collar torus was
	# clipping to a flat white ring - the "white ring round the neck" the player
	# reported. Lowering the specular and roughening the metal keeps the gold
	# readable as metal while it reflects a sky instead of a searchlight.
	_piece_gold_material = _luxury_piece_material(accent, palette.accent_roughness, palette.accent_metallic, false, false, 0.24)


## Fine procedural carving shared by both piece sets. A FastNoiseLite turned
## into a 128x128 normal map, built as a plain Image and cached once, so every
## one of the thirty-two pieces shares a single texture resource: nothing here
## is regenerated per piece, per theme switch or per frame. This needs UVs on
## the mesh, which is why _piece_mesh() projects them onto the OBJ bodies.
func _piece_carve_map() -> Texture2D:
	if _mesh_cache.has("carve_normal"):
		return _mesh_cache["carve_normal"]
	var size := 128
	var grain := FastNoiseLite.new()
	grain.seed = 4471
	grain.noise_type = FastNoiseLite.TYPE_SIMPLEX
	grain.frequency = 0.08
	var heights := PackedFloat32Array()
	heights.resize(size * size)
	for y in size:
		for x in size:
			heights[y * size + x] = grain.get_noise_2d(float(x), float(y))
	var image := Image.create(size, size, true, Image.FORMAT_RGB8)
	var strength := 3.0
	for y in size:
		for x in size:
			var left: float = heights[y * size + ((x - 1 + size) % size)]
			var right: float = heights[y * size + ((x + 1) % size)]
			var up: float = heights[((y - 1 + size) % size) * size + x]
			var down: float = heights[((y + 1) % size) * size + x]
			var normal := Vector3(left - right, up - down, 1.0 / strength).normalized()
			image.set_pixel(x, y, Color(normal.x * 0.5 + 0.5, normal.y * 0.5 + 0.5, normal.z * 0.5 + 0.5, 1.0))
	image.generate_mipmaps()
	var texture := ImageTexture.create_from_image(image)
	_mesh_cache["carve_normal"] = texture
	return texture


## The Staunton OBJ bodies carry no vt records, so they arrive with no UV
## attribute at all. A material with textures on a mesh without UVs makes the
## Compatibility renderer sample undefined coordinates, which is exactly what
## used to blow the ivory out to flat white. This projects a cylindrical UV set
## over the mesh once and caches the result: it removes that whole class of bug
## and it is what lets the piece materials carry the micro-detail normal map.
func _piece_mesh(kind: String) -> Mesh:
	# The body set is part of the key: the two sets share kind names and nothing
	# else, and the cache outlives a single board build.
	var cache_key := "piece:%s:%s" % [_piece_set(), kind]
	if _mesh_cache.has(cache_key):
		return _mesh_cache[cache_key]
	# The model dictionary is a Dictionary, so indexing it yields Variant; an explicit
	# type is what lets the rest of this function be checked at all.
	var models := _piece_models()
	if not models.has(kind):
		# A missing body must never take the board down with it: fall back to the
		# turned set, which every install ships and which covers all six kinds.
		models = _piece_models_for("staunton")
	var source: Mesh = models.get(kind)
	if source == null or source.get_surface_count() == 0:
		return source
	var arrays := source.surface_get_arrays(0)
	var positions: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
	var has_uvs: bool = arrays[Mesh.ARRAY_TEX_UV] != null
	var has_normals: bool = arrays[Mesh.ARRAY_NORMAL] != null
	if has_uvs and has_normals:
		var existing_uvs: PackedVector2Array = arrays[Mesh.ARRAY_TEX_UV]
		if existing_uvs.size() == positions.size():
			# Already complete, so there is nothing to project.
			_mesh_cache[cache_key] = source
			return source
	var source_normals: PackedVector3Array = PackedVector3Array()
	if has_normals:
		source_normals = arrays[Mesh.ARRAY_NORMAL]
	var indices: PackedInt32Array = PackedInt32Array()
	if arrays[Mesh.ARRAY_INDEX] != null:
		indices = arrays[Mesh.ARRAY_INDEX]
	var lowest := 0.0
	var highest := 0.0
	for point in positions:
		lowest = minf(lowest, point.y)
		highest = maxf(highest, point.y)
	var span := maxf(0.0001, highest - lowest)
	# The bodies ship with no vn records either, so their faces arrive flat
	# shaded. Averaging the area-weighted face normal of every welded vertex is
	# what turns the bishop's mitre and the queen's coronet from facets into
	# carved curves, and it costs one pass at load time on a mesh that is then
	# cached and shared. The knight benefits most of all: its brow, cheek and mane
	# are one continuous surface, and welding the duplicated export vertices is
	# what keeps them from shading as facets.
	var smoothed: PackedVector3Array = PackedVector3Array()
	if not has_normals:
		smoothed = _smoothed_normals(positions, indices)
	# The gold rule round the foot of a sculpted figure, built as a real ring with
	# its own surface and material.
	#
	# Two earlier versions of this are worth recording, because both failed for
	# structural reasons rather than for want of tuning. Tinting the vertices with
	# an albedo multiplier cannot work: one multiplier has to serve a pale albedo
	# and a lapis one, so the gold on one army is a grey line on the other and
	# bright enough for the dark army it clips the pale one to white. Cutting the
	# rule out of the body's own triangles at a fixed height cannot work either:
	# a carved plinth has no constant radius, so the slab catches the shoulders
	# where the mesh happens to have vertex rows and breaks into dashes.
	#
	# What works is to measure the plinth: sample its radius in angular bins at
	# the height of the rule, take a high percentile rather than the maximum, and
	# then sweep a ribbon round those measured radii. The ribbon follows the
	# lobes, cannot break, cannot float, and is the same gold on both armies.
	var tool := SurfaceTool.new()
	tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	var rule := SurfaceTool.new()
	rule.begin(Mesh.PRIMITIVE_TRIANGLES)
	var has_rule := false
	if _piece_set() != "staunton" and positions.size() > 0:
		var plinth_top: float = float(SET_PLINTH_FRACTION.get(kind, 0.11)) * highest
		has_rule = _add_gold_ribbon(rule, positions, plinth_top, highest)
	for i in positions.size():
		var vertex: Vector3 = positions[i]
		var angle := atan2(vertex.z, vertex.x)
		tool.set_color(Color(1.0, 1.0, 1.0))
		# Two wraps around the piece keeps the carving fine enough to read as
		# detail rather than as one big smear.
		if has_normals:
			tool.set_normal(source_normals[i])
		else:
			tool.set_normal(smoothed[i])
		tool.set_uv(Vector2(angle / TAU + 0.5, (vertex.y - lowest) / span) * 2.0)
		tool.add_vertex(vertex)
	for index in indices:
		tool.add_index(index)
	# The Staunton bodies carry neither vt nor vn records, so they arrive with no
	# UV and no normal attribute. Both are produced here: without them the
	# renderer samples undefined coordinates, which is what used to blow the ivory
	# out to flat white, and without tangents the carve map cannot be applied.
	tool.generate_tangents()
	var mesh := tool.commit()
	if has_rule:
		rule.generate_tangents()
		mesh = rule.commit(mesh)
	_mesh_cache[cache_key] = mesh
	return mesh


## Builds the gold rule round a sculpted figure's plinth into `rule`.
##
## The radius is measured, not assumed. The plinth is scalloped - its lobes and
## valleys differ by a third on these meshes - so a circle that is right on a
## lobe buries itself in the valleys and one right on a valley floats over the
## lobes. Sampling the mesh in angular bins at the height of the band and taking
## the second-largest radius in each bin gives a line that sits on the carving
## the whole way round; smoothing the samples afterwards keeps the band from
## turning into a polygon of the carving's noise.
##
## Returns false when the plinth could not be measured at all, which is what
## happens on a mesh whose base is not where the profile says it is.
func _add_gold_ribbon(rule: SurfaceTool, positions: PackedVector3Array, plinth_top: float, highest: float) -> bool:
	const BINS := 96
	# Where the ribbon goes: the wall of the plinth, not its shoulder. This is the
	# correction that took three renders to see. A band at the top of the step is
	# a vertical wall standing under a horizontal lip, and from a camera looking
	# down at the board the lip hides it - the gold shows as scattered slivers no
	# matter how thick the band is. Dropped 0.03 of the piece's height it sits on
	# the open wall of the carving, where the camera can see it and where there is
	# engraving behind it for it to read against.
	var band_low := plinth_top - 0.036 * highest
	var band_high := plinth_top - 0.002 * highest
	# The window has to match the band it is measuring, and this is the whole
	# trick: sample much wider and the measurement is dominated by the flare below,
	# so the ribbon is built at a radius the plinth has already grown past and the
	# carving swallows it.
	var sample_low := band_low - 0.004 * highest
	var sample_high := band_high + 0.004 * highest
	# The ribbon stands slightly further out than the surface it was measured on,
	# because the measurement is of vertex rows, not of the true surface between
	# them.
	const CLEARANCE := 0.004
	var best := PackedFloat32Array()
	var second := PackedFloat32Array()
	var seen := PackedByteArray()
	best.resize(BINS)
	second.resize(BINS)
	seen.resize(BINS)
	for i in positions.size():
		var vertex: Vector3 = positions[i]
		if vertex.y < sample_low or vertex.y > sample_high:
			continue
		var radius := sqrt(vertex.x * vertex.x + vertex.z * vertex.z)
		if radius < 0.02:
			continue
		var angle := atan2(vertex.z, vertex.x)
		var bin := clampi(int(floor((angle + PI) / TAU * float(BINS))), 0, BINS - 1)
		seen[bin] = 1
		if radius > best[bin]:
			second[bin] = best[bin]
			best[bin] = radius
		elif radius > second[bin]:
			second[bin] = radius
	var covered := 0
	for bin in BINS:
		covered += seen[bin]
	if covered < BINS / 2:
		return false
	# The largest radius in each bin, and this is the second correction the
	# measurement needed. A high percentile looked safer - one stray vertex from a
	# tail should not push a third of the ring into the air - but on a carved base
	# the percentiles are the problem: the lobes stick 0.01-0.016 past the median,
	# so a ring built at the second-largest radius is buried inside the carving
	# and shows only as slivers between lobes. Sitting just outside the worst lobe
	# in each direction is the only placement the carving cannot swallow.
	var radii := PackedFloat32Array()
	radii.resize(BINS)
	for bin in BINS:
		radii[bin] = best[bin] if best[bin] > 0.0 else second[bin]
	# Fill any empty bin from its neighbour before smoothing, so the sweep has no
	# zero-radius hole in it.
	for bin in BINS:
		if not seen[bin]:
			radii[bin] = radii[(bin - 1 + BINS) % BINS]
	# One pass only: enough to keep the band from being a polygon of the mesh's
	# noise, not so much that it cuts across the lobes it is following.
	for pass_index in 1:
		var smoothed_radii := radii.duplicate()
		for bin in BINS:
			var prev := radii[(bin - 1 + BINS) % BINS]
			var next := radii[(bin + 1) % BINS]
			smoothed_radii[bin] = prev * 0.25 + radii[bin] * 0.5 + next * 0.25
		radii = smoothed_radii
	# Three rows, so the ribbon has a crown and reads as a raised band rather than
	# as a painted line: the top and bottom rows sit back on the surface and the
	# middle row stands a fraction proud.
	# A crowned profile, four rows: a chamfer facing up, a proud face, a second
	# face, and a chamfer facing down. The upward tilt on the top rows is not
	# decoration - the key light in this scene comes from above and to the left,
	# and a band whose normals point straight out sideways is lit by the fill only
	# and renders as brown. That is the same trap the flat-annulus trim fell into
	# two rounds ago, and a few pixels wide it is much less forgiving.
	var band_span := band_high - band_low
	var rows := [band_low, band_low + band_span * 0.30, band_high - band_span * 0.30, band_high]
	var spreads := [0.994, 1.010, 1.010, 0.994]
	var tilts := [1.15, 0.20, 0.20, -0.85]
	var segments := BINS
	var row_count := rows.size()
	var ring: Array[PackedVector3Array] = []
	for row in row_count:
		var points := PackedVector3Array()
		points.resize(segments + 1)
		for segment in segments + 1:
			var bin := segment % BINS
			var angle := -PI + TAU * float(segment) / float(segments)
			var radius := float(radii[bin]) * float(spreads[row]) + CLEARANCE * highest
			points[segment] = Vector3(cos(angle) * radius, float(rows[row]), sin(angle) * radius)
		ring.append(points)
	for row in row_count - 1:
		for segment in segments:
			var angle := -PI + TAU * (float(segment) + 0.5) / float(segments)
			var facing := Vector3(cos(angle), 0.0, sin(angle))
			var a := ring[row][segment]
			var b := ring[row][segment + 1]
			var c := ring[row + 1][segment + 1]
			var d := ring[row + 1][segment]
			var normal_row := float(tilts[row])
			var normal_next := float(tilts[row + 1])
			rule.set_normal((facing + Vector3.UP * normal_row).normalized())
			rule.set_uv(Vector2(float(segment) / float(segments) * 3.0, 0.0))
			rule.add_vertex(a)
			rule.set_normal((facing + Vector3.UP * normal_row).normalized())
			rule.set_uv(Vector2(float(segment + 1) / float(segments) * 3.0, 0.0))
			rule.add_vertex(b)
			rule.set_normal((facing + Vector3.UP * normal_next).normalized())
			rule.set_uv(Vector2(float(segment + 1) / float(segments) * 3.0, 1.0))
			rule.add_vertex(c)
			rule.set_normal((facing + Vector3.UP * normal_row).normalized())
			rule.set_uv(Vector2(float(segment) / float(segments) * 3.0, 0.0))
			rule.add_vertex(a)
			rule.set_normal((facing + Vector3.UP * normal_next).normalized())
			rule.set_uv(Vector2(float(segment + 1) / float(segments) * 3.0, 1.0))
			rule.add_vertex(c)
			rule.set_normal((facing + Vector3.UP * normal_next).normalized())
			rule.set_uv(Vector2(float(segment) / float(segments) * 3.0, 1.0))
			rule.add_vertex(d)
	return true


## Where the plinth ends, as a fraction of each piece's own height. Read off the
## radius profile of the shipped meshes: the base flares to 0.38 on the king and
## steps in to 0.26 just above the engraving, and the same step is at 0.10 of the
## height on the figures that stand rather than sit. One number per kind rather
## than one for the set, because a rook's plinth is proportionally taller than a
## queen's.
const SET_PLINTH_FRACTION := {
	"pawn": 0.105,
	"rook": 0.150,
	"knight": 0.135,
	"bishop": 0.125,
	"queen": 0.110,
	"king": 0.105,
}

## The silhouette the Staunton bodies ship with, sampled once per kind and
## cached. The ornament lathe follows this instead of an invented curve, so the
## carved stem cannot strangle the piece: whatever radius the mesh reaches at a
## given height is the radius the lathe is given there.
const BODY_PROFILE_STEPS := 32

func _body_profile(kind: String) -> Dictionary:
	var cache_key := "bodyprofile:%s:%s" % [_piece_set(), kind]
	if _mesh_cache.has(cache_key):
		return _mesh_cache[cache_key]
	var source: Mesh = _piece_models()[kind]
	var positions: PackedVector3Array = source.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]
	var lowest := 0.0
	var highest := 0.0
	for point in positions:
		lowest = minf(lowest, point.y)
		highest = maxf(highest, point.y)
	var span := maxf(0.0001, highest - lowest)
	var radii := PackedFloat32Array()
	radii.resize(BODY_PROFILE_STEPS)
	for point in positions:
		var step := int(clampf((point.y - lowest) / span, 0.0, 0.999999) * float(BODY_PROFILE_STEPS))
		var radius: float = Vector2(point.x, point.z).length()
		if radius > radii[step]:
			radii[step] = radius
	# The meshes are not uniformly dense in y: several kinds have height bands
	# with no vertex at all, which would leave a zero in the table and pinch the
	# lathe to nothing exactly where the stem is narrowest. Any empty step is
	# filled by interpolating between the nearest steps that do have geometry.
	for i in BODY_PROFILE_STEPS:
		if radii[i] > 0.0001:
			continue
		var before := i - 1
		while before >= 0 and radii[before] <= 0.0001:
			before -= 1
		var after := i + 1
		while after < BODY_PROFILE_STEPS and radii[after] <= 0.0001:
			after += 1
		if before < 0 and after >= BODY_PROFILE_STEPS:
			continue
		if before < 0:
			radii[i] = radii[after]
		elif after >= BODY_PROFILE_STEPS:
			radii[i] = radii[before]
		else:
			var blend: float = float(i - before) / float(after - before)
			radii[i] = lerpf(radii[before], radii[after], blend)
	var profile := {"lowest": lowest, "span": span, "radii": radii}
	_mesh_cache[cache_key] = profile
	return profile


## Largest radius the shipped body reaches at world height `y`, linearly
## interpolated between the sampled steps.
func _body_radius_at(kind: String, y: float) -> float:
	var profile: Dictionary = _body_profile(kind)
	var radii: PackedFloat32Array = profile["radii"]
	var lowest: float = profile["lowest"]
	var span: float = profile["span"]
	var scaled: float = clampf((y - lowest) / span, 0.0, 1.0) * float(radii.size() - 1)
	var i := int(floorf(scaled))
	if i >= radii.size() - 1:
		return radii[radii.size() - 1]
	return lerpf(radii[i], radii[i + 1], scaled - float(i))


## Radius of a *sculpted* piece at a height, taken from the mesh itself.
##
## The turned sets' silhouette is a table of numbers (_body_profile), so every
## band and collar can ask for the radius analytically. A sculpted piece has no
## such table: a guard is 0.40 wide at the plinth and 0.16 at the neck, a
## queen's robe flares out where the king's does not, and the two are different
## shapes at the same height. Asking the Staunton table about them - which is
## what the trim used to do - put every gold rule a centimetre off the surface,
## floating round the piece like a dropped bracelet. So the radius is measured
## from the vertices once per set and kind and cached as a 96-bin profile.
const SET_PROFILE_STEPS := 96


func _set_profile(kind: String) -> Dictionary:
	var key := "setprofile:%s:%s" % [_piece_set(), kind]
	if _mesh_cache.has(key):
		return _mesh_cache[key]
	var profile := PackedFloat32Array()
	profile.resize(SET_PROFILE_STEPS)
	var height := 0.0
	var models := _piece_models()
	var mesh: Mesh = models.get(kind)
	if mesh != null and mesh.get_surface_count() > 0:
		var positions: PackedVector3Array = mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]
		for point in positions:
			height = maxf(height, point.y)
		if height > 0.0001:
			for point in positions:
				var radius := Vector2(point.x, point.z).length()
				var bin := int(clampf(point.y / height, 0.0, 0.999999) * float(SET_PROFILE_STEPS - 1))
				profile[bin] = maxf(profile[bin], radius)
	var described := {"profile": profile, "height": height}
	_mesh_cache[key] = described
	return described


## How tall the current set's piece of this kind is, in board units.
func _set_height(kind: String) -> float:
	if _piece_set() == "staunton":
		var profile: Dictionary = _body_profile(kind)
		return float(profile.lowest) + float(profile.span)
	var described := _set_profile(kind)
	return float(described.height)


## The radius of the current set's body at a height, in board units.
func _set_radius_at(kind: String, y: float) -> float:
	if _piece_set() == "staunton":
		return _body_radius_at(kind, y)
	var described := _set_profile(kind)
	var profile: PackedFloat32Array = described.profile
	var height: float = described.height
	if height <= 0.0001:
		return 0.0
	var scaled: float = clampf(y / height, 0.0, 1.0) * float(profile.size() - 1)
	var i := int(floorf(scaled))
	if i >= profile.size() - 1:
		return profile[profile.size() - 1]
	return lerpf(profile[i], profile[i + 1], scaled - float(i))


## d(radius)/d(height) of the shipped silhouette, differenced numerically so the
## lathe's surface normal follows the real curve. A straight radial normal on a
## surface this steep is wrong by up to sixty degrees and the stem shades as a
## cone instead of as turned wood.
func _body_slope_at(kind: String, y: float) -> float:
	var delta := 0.012
	return (_body_radius_at(kind, y + delta) - _body_radius_at(kind, y - delta)) / (2.0 * delta)


## Averages the area-weighted face normal of every vertex that shares a
## position, which welds the duplicated vertices an OBJ export leaves behind and
## gives one smooth normal per corner of the solid. Positions are quantised to a
## 0.0005 grid so floating-point noise cannot split what is really one point.
func _smoothed_normals(positions: PackedVector3Array, indices: PackedInt32Array) -> PackedVector3Array:
	var slots := PackedInt32Array()
	slots.resize(positions.size())
	var accumulators: Array = []
	var lookup := {}
	for i in positions.size():
		var point: Vector3 = positions[i]
		var key := "%d_%d_%d" % [roundi(point.x * 2000.0), roundi(point.y * 2000.0), roundi(point.z * 2000.0)]
		if not lookup.has(key):
			lookup[key] = accumulators.size()
			accumulators.append(Vector3.ZERO)
		slots[i] = lookup[key]
	for corner in range(0, indices.size(), 3):
		var a: int = indices[corner]
		var b: int = indices[corner + 1]
		var c: int = indices[corner + 2]
		var face: Vector3 = (positions[b] - positions[a]).cross(positions[c] - positions[a])
		if face.length_squared() < 0.0000001:
			continue
		accumulators[slots[a]] = (accumulators[slots[a]] as Vector3) + face
		accumulators[slots[b]] = (accumulators[slots[b]] as Vector3) + face
		accumulators[slots[c]] = (accumulators[slots[c]] as Vector3) + face
	var normals := PackedVector3Array()
	normals.resize(positions.size())
	for i in positions.size():
		var accumulated: Vector3 = accumulators[slots[i]]
		normals[i] = accumulated.normalized() if accumulated.length_squared() > 0.0000001 else Vector3.UP
	return normals


func _create_board() -> void:
	# All three board themes share one geometry - the grid plus the centred slabs
	# below it - so nothing is rebuilt or duplicated when the theme changes; only
	# colour, grain and the inlay metal differ. The palette comes from
	# BOARD_THEMES, keyed by the user's choice, and not from the piece theme: any
	# set of pieces can be played on any board.
	var palette: Dictionary = BOARD_THEMES.get(board_theme, BOARD_THEMES["classic"])
	# The classic light square is deliberately below the brief's 0.86. At 0.86 the
	# square is indistinguishable from the alabaster pieces, and even at 0.80 the
	# square saturated: with the relief and the fill's grazing shadows both doing
	# less work than the geometry they replaced, it rendered as flat #ffffff with
	# no veining and no shadow gradient left on it. 0.745 keeps it a warm polished
	# stone with its figure intact, and it is the only albedo in the scene sitting
	# this close to the top of the ACES curve.
	# Both light squares sit below the brief's 0.86 / 0.82 for the same reason: at
	# the brief's values they saturated once the relief and the fill's grazing
	# shadows both did less work than the piece geometry they replaced. The
	# royal_wood square ran to #fff194 - a hot yellow with the red channel pinned
	# at 255 - where the accepted render measured #cf9f60.
	var light_square: Color = palette.light_square
	var dark_square: Color = palette.dark_square
	var square_roughness: float = palette.square_roughness
	# The outer frame was a near-black albedo (0.14), which renders as an unlit
	# silhouette no matter what the lighting does. It is now a light-reactive
	# surface in its own right - brushed dark slate for classic, warm mahogany for
	# royal_wood - with the roughness and metallic the brief asks for, and the
	# bevel step below gives it an angled facet that actually catches the key
	# light instead of one flat normal pointing straight up.
	var apron: Color = palette.apron
	var apron_roughness: float = palette.apron_roughness
	var apron_metallic: float = palette.apron_metallic
	# The inner trim ring is the metal inlay between the grid and the apron. It
	# has to stay a metal, but at metallic_specular 0.50 the sky reflection rode
	# on top of the diffuse term and the whole ring clipped into a flat white
	# stripe running down the h-file side of the board.
	# The inlay between the grid and the apron. It has to stay a metal, but it is
	# deliberately a dark, rough one: at 0.82 with a 0.50 specular it read as a
	# bright white band down the side of the board, and even at 0.62 the grazing
	# rim light left a visible stripe to the right of file h. Rougher and darker
	# still, it reads as machined metal let into the frame.
	var trim: Color = palette.trim
	var trim_roughness: float = palette.trim_roughness
	var table: Color = palette.table
	# The squares carry no albedo texture at all (see the note below), so only
	# the apron and the table need a tile pattern. It follows the family the
	# theme belongs to: stone boards get marble, wooden ones get rosewood.
	var apron_map: String = palette.apron_map
	# metallic_specular is pinned low on the squares: at Godot's 0.5 default a
	# broad flat face reflects the whole sky on top of its diffuse term and
	# clips to white under ACES.
	# The squares carry no albedo texture at all - flat colour, no veining, no
	# figure. The brief asks for smooth squares free of 45-degree diagonal lines,
	# and a noise field on a face this broad is only ever a pattern: on the far
	# ranks, where a tile is nine pixels wide on screen, it aliases into visible
	# banding no matter how the mip chain is filtered. The frame and the table keep
	# their maps, because there the surface is large enough for the figure to read.
	_board_light_material = _material(light_square, square_roughness, 0.0, false, 0.05)
	_board_dark_material = _material(dark_square, square_roughness, 0.0, false, 0.05)
	var apron_material := _material(apron, apron_roughness, apron_metallic, false, 0.06,
		_surface_map(apron_map), _surface_map(apron_map + "_normal"))
	var trim_material := _material(trim, trim_roughness, 0.90, false, 0.10)
	var table_material := _matte_material(table, 0.55,
		_surface_map(apron_map), _surface_map(apron_map + "_normal"), 0.06)

	# The grid is static, so the 32 light squares share one surface and the 32
	# dark squares share another: two draw calls instead of 64, and two mesh
	# resources instead of 64 unique BoxMeshes. Each square is centred at
	# (file - 3.5) * tile_size and (rank - 3.5) * tile_size, so the grid spans
	# exactly -4.0 * tile_size to +4.0 * tile_size around the origin.
	#
	# That is the same centre the trim slab, the apron, the plinth and both table
	# steps use, and the same origin the a-h and 1-8 labels are measured from, so
	# the grid, the frame and the letters all agree on where the middle of the
	# board is. There is deliberately no half-tile offset anywhere: a tile centre
	# of (file - 3.5) puts the a-file's left edge and the h-file's right edge
	# exactly 4.0 out, which is exactly where the trim ring starts, so the exposed
	# inlay is the same width on all four sides.
	var square_mesh := _shared_square_mesh()
	var light_tool := SurfaceTool.new()
	light_tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	var dark_tool := SurfaceTool.new()
	dark_tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	for rank in BOARD_SIZE:
		for file in BOARD_SIZE:
			var square_tool := light_tool if (file + rank) % 2 == 0 else dark_tool
			square_tool.append_from(square_mesh, 0, Transform3D(Basis.IDENTITY,
				Vector3((file - 3.5) * SQUARE_SIZE, 0.0, (rank - 3.5) * SQUARE_SIZE)))
	for merged in [light_tool, dark_tool]:
		var squares := MeshInstance3D.new()
		squares.mesh = merged.commit()
		squares.material_override = _board_light_material if merged == light_tool else _board_dark_material
		board.add_child(squares)

	# Slab three: the metallic trim. A solid centred slab under the grid whose
	# exposed ring is only 0.05 wide on every side, with its top face a hair under
	# the tile tops, so it reads as a machined inlay rather than a painted stripe.
	_add_board_box(Vector3(0, -0.012, 0), Vector3(8.10, 0.162, 8.10), trim_material)
	# Slab two: the apron, split into two centred tiers so the frame carries a
	# real 3D step instead of one flat top. The outer tier is the full 9.40 wide
	# and the inner tier rises 0.017 above it to hold the coordinate labels, which
	# is what gives the border a chamfered edge with two differently angled faces
	# for the key light to catch. Both tiers are centred on the origin, so there
	# is never a slot, a seam, a lip or an overhang anywhere for the backdrop to
	# show through - the old multi-part frame left exactly that, a black trench
	# around the grid and under the letters. The labels sit on solid material
	# either way.
	#
	# The inner tier's top stops at 0.065, five millimetres under the tile tops,
	# and that clearance is deliberate. With the tier raised to 0.070 it stood
	# level with the grid, and the frame then rose into the key light's grazing
	# angle far enough to shadow the squares: every pale square dropped to about a
	# fifth of its albedo while the pieces - the casters, sitting above their own
	# shadows - stayed bright. Five millimetres of step is all the bevel needs and
	# it keeps the frame below the grid.
	_add_board_box(Vector3(0, -0.0235, 0), Vector3(9.40, 0.143, 9.40), apron_material)
	_add_board_box(Vector3(0, 0.0565, 0), Vector3(9.06, 0.017, 9.06), apron_material)
	# The plinth and the two table steps below it. Each is centred and exactly as
	# wide as the slab above, so the stack runs continuously from the tile
	# bottoms down to the table with no gap and no overhang on any side.
	_add_board_box(Vector3(0, -0.145, 0), Vector3(9.40, 0.10, 9.40), apron_material)
	_add_board_box(Vector3(0, -0.295, 0), Vector3(10.40, 0.20, 10.40), table_material)
	_add_board_box(Vector3(0, -0.545, 0), Vector3(11.60, 0.30, 11.60), table_material)

	_add_board_coordinates()


## One shared box for every square on the board. Building it once instead of
## once per square is what lets all 64 of them collapse into two surfaces.
func _shared_square_mesh() -> BoxMesh:
	if _mesh_cache.has("board_square"):
		return _mesh_cache["board_square"]
	var mesh := BoxMesh.new()
	mesh.size = Vector3(SQUARE_SIZE, 0.14, SQUARE_SIZE)
	_mesh_cache["board_square"] = mesh
	return mesh


func _add_board_coordinates() -> void:
	# Brass (or champagne) engraving on the apron, lit rather than unshaded so it
	# catches the key light the way real engraved metal does. Slab one's top face
	# is at y = 0.065, so the labels sit a hair above solid material: placed any
	# lower they end up buried inside the mesh and simply vanish, and there is
	# never a void underneath them.
	#
	# Both axes use (index - 3.5) * tile_size, exactly the centre of the tile they
	# name, so the letters and the digits sit on the tiles they refer to rather
	# than half a tile off them.
	var label_color: Color = BOARD_THEMES.get(board_theme, BOARD_THEMES["classic"]).label_color
	var label_y := 0.073
	for index in BOARD_SIZE:
		for data in [
			["abcdefgh"[index], Vector3((index - 3.5) * SQUARE_SIZE, label_y, 4.22)],
			[str(8 - index), Vector3(-4.22, label_y, (index - 3.5) * SQUARE_SIZE)]
		]:
			var label := Label3D.new()
			label.text = data[0]
			label.font_size = 36
			label.modulate = label_color
			label.shaded = true
			label.outline_size = 6
			label.outline_modulate = Color(0.05, 0.03, 0.03, 0.92)
			label.position = data[1]
			label.rotation_degrees.x = -90.0
			label.pixel_size = 0.0034
			coordinates_root.add_child(label)


func _add_board_box(position: Vector3, size: Vector3, material: Material) -> void:
	var instance := MeshInstance3D.new()
	var mesh := BoxMesh.new()
	mesh.size = size
	mesh.material = material
	instance.mesh = mesh
	instance.position = position
	board.add_child(instance)


func _create_pieces() -> void:
	for child in pieces_root.get_children():
		child.queue_free()
	for rank in BOARD_SIZE:
		for file in BOARD_SIZE:
			var code: String = game.board[rank][file]
			if code != "":
				_add_piece(_kind_for_code(code), code, file, rank, _body_material(code), _piece_gold_material)


## Reconciles the piece nodes with the current board without rebuilding all
## thirty-two pieces after every move. Nodes that stay on the same square with
## the same piece kind are reused; only the moved, captured and promoted pieces
## are touched. _create_pieces() is still used for resets and quality changes.
func _sync_pieces() -> void:
	var existing: Dictionary = {}
	for piece in pieces_root.get_children():
		existing[piece.get_meta("square", Vector2i(-1, -1))] = piece
	for rank in BOARD_SIZE:
		for file in BOARD_SIZE:
			var square := Vector2i(file, rank)
			var code: String = game.board[rank][file]
			if not existing.has(square):
				if code != "":
					_add_piece(_kind_for_code(code), code, file, rank, _body_material(code), _piece_gold_material)
				continue
			var node: Node3D = existing[square]
			if code == "":
				node.queue_free()
				continue
			var kind := _kind_for_code(code)
			if String(node.get_meta("kind", "")) != kind:
				node.queue_free()
				_add_piece(kind, code, file, rank, _body_material(code), _piece_gold_material)
			else:
				node.name = _piece_node_name(kind, file, rank)
				node.set_meta("square", square)
				node.position = Vector3((file - 3.5) * SQUARE_SIZE, 0.072, (rank - 3.5) * SQUARE_SIZE)


func _kind_for_code(code: String) -> String:
	return String(PIECE_KINDS.get(code.to_lower(), "pawn"))


func _body_material(code: String) -> Material:
	return _piece_ivory_material if code == code.to_upper() else _piece_obsidian_material


## Which of the two body sets the current piece theme is wearing.
func _piece_set() -> String:
	var palette: Dictionary = PIECE_THEMES.get(piece_theme, PIECE_THEMES["classic"])
	return String(palette.get("model_set", "staunton"))


## The six bodies of the set the player is wearing, loaded on first use.
func _piece_models() -> Dictionary:
	return _piece_models_for(_piece_set())


## Loads (once) and returns one set's six bodies by name.
func _piece_models_for(set_name: String) -> Dictionary:
	if not _loaded_piece_models.has(set_name):
		var paths: Dictionary = PIECE_MODEL_PATHS.get(set_name, PIECE_MODEL_PATHS["staunton"])
		var loaded := {}
		for kind in paths:
			var body: Resource = load(paths[kind])
			if body != null:
				loaded[kind] = body
		_loaded_piece_models[set_name] = loaded
	return _loaded_piece_models[set_name]


## How far round a piece has to be turned so that it faces the enemy - i.e. up
## the board for White and down it for Black, the way a set is arranged on a
## table.
##
## The two body sets were sculpted facing opposite ways. The Staunton knight's
## muzzle points down -Z and the medieval one's points up +Z (the medieval king
## and queen hold their staff and orb in front of them, likewise +Z), so the two
## need opposite yaws for the same result. Everything else about the facing is
## shared, which is why it is one function and not one per set.
func _facing_yaw(is_white: bool) -> float:
	# Two facts decide this, and both are facts about the geometry rather than
	# about taste:
	#
	#   1. White stands on the +Z half of the board and Black on the -Z half (the
	#      camera is at +Z, which is why White is the near army on screen).
	#   2. The turned Staunton bodies are sculpted with their muzzle down -Z; the
	#      two sculpted sets are sculpted with theirs up +Z.
	#
	# To face the enemy, White has to look -Z and Black +Z. So a -Z-front body
	# needs no turn for White and half a turn for Black, and a +Z-front body
	# needs exactly the opposite. Getting this backwards - which it was - made
	# every pair of knights stare away from each other, backs to the middle of
	# the board.
	var front_is_plus_z := _piece_set() != "staunton"
	if front_is_plus_z:
		return PI if is_white else 0.0
	return 0.0 if is_white else PI


## How far to turn one piece so that it faces the enemy.
##
## Which kinds have a front at all is a property of the set, and getting that
## wrong is visible immediately:
##
##  * The turned Staunton bodies are bodies of revolution. Only the bishop has a
##    side at all - its mitre slit is cut on one face - so only the bishop is
##    turned, by a quarter turn, which is what squares the slit to the camera.
##  * Both sculpted sets are full figures. The pawn is a guard with a shield on
##    one arm and a spear in the other hand, the bishop is an elephant, the
##    knight is a rearing horse, and the king and queen hold a sceptre and a
##    cup in front of them. Every one of those has a front, so every one of
##    them gets the per-army facing yaw. Leaving the pawn out - which is what
##    happened when only the king and queen were listed - left a rank of guards
##    staring at their own player while the rest of the army faced the enemy.
func _piece_yaw(kind: String, _file: int, is_white: bool) -> float:
	if _piece_set() == "staunton":
		return PI * 0.25 if (kind == "bishop" and is_white) else (PI * 1.25 if kind == "bishop" else 0.0)
	match kind:
		"pawn", "knight", "bishop", "king", "queen":
			return _facing_yaw(is_white)
	return 0.0


## Which carved variant the current piece theme asks for. Kept in one place so
## the trim cache key, the trim builder and the piece assembly can never
## disagree about which set of carving is being built.
func _trim_variant() -> String:
	var palette: Dictionary = PIECE_THEMES.get(piece_theme, PIECE_THEMES["classic"])
	return String(palette.trim_variant)


func _piece_node_name(kind: String, file: int, rank: int) -> String:
	return "%s_%d_%d" % [kind.capitalize(), file, rank]


## Walks a piece's subtree and forces the body material onto every mesh that is
## not the merged trim mesh. The trim carries its own two surfaces with their
## materials already set, so it is left alone; anything else - a sub-mesh someone
## adds later - would otherwise render with Godot's default white material.
func _apply_piece_materials(piece: Node3D, body: Material) -> void:
	for child in piece.get_children():
		var mesh_instance := child as MeshInstance3D
		if mesh_instance == null:
			continue
		if mesh_instance.name == "OrnateTrim":
			continue
		# A mesh with more than one surface has already been given a material per
		# surface; overriding it here would paint the gold rule out.
		if mesh_instance.mesh != null and mesh_instance.mesh.get_surface_count() > 1:
			continue
		if mesh_instance.material_override == null:
			mesh_instance.material_override = body


func _add_piece(kind: String, code: String, file: int, rank: int, body: Material, accent: Material) -> void:
	var is_white := code == code.to_upper()
	var piece := Node3D.new()
	piece.name = _piece_node_name(kind, file, rank)
	# The tile tops are at y = 0.07, so a piece sits directly on its square
	# instead of hovering the width of its own base above it.
	piece.position = Vector3((file - 3.5) * SQUARE_SIZE, 0.072, (rank - 3.5) * SQUARE_SIZE)
	piece.set_meta("square", Vector2i(file, rank))
	piece.set_meta("kind", kind)
	piece.set_meta("code", code)
	pieces_root.add_child(piece)

	# Every kind, the knight included, ships as a real sculpted body. Five of them
	# come from the Staunton-Pieces set; the knight does not, because that set's
	# knight is a thin slab of a head and the round before this one shipped it
	# anyway, which is what the player saw as a lump on a square. The body beside
	# the other five is now generated by tools/build_knight.py: a jaw, a cheek, a
	# brow, a muzzle that juts out over the throat, two ears and a scalloped mane,
	# all one watertight mesh with the same 0.326 foot as its neighbours.
	var model := MeshInstance3D.new()
	model.name = "SculptedModel"
	model.mesh = _piece_mesh(kind)
	# A sculpted body can carry a second surface - the gold rule cut out of its
	# foot - and material_override would bury that surface under the body colour.
	# Where there are two surfaces the materials are set per surface instead,
	# which is per instance and so still lets the two armies share one mesh.
	if model.mesh != null and model.mesh.get_surface_count() > 1:
		model.set_surface_override_material(0, body)
		for surface in range(1, model.mesh.get_surface_count()):
			model.set_surface_override_material(surface, _gold_rule())
	else:
		model.material_override = body
	model.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	model.rotation.y = _piece_yaw(kind, file, is_white)
	piece.add_child(model)
	# The Staunton bodies are deliberately plain, so all the carving - tiered
	# foot, filigree, fluting, collars and the crowns - lives in this one merged
	# trim mesh rather than in a swarm of child nodes. How much carving there is
	# depends on the chosen piece theme: see TRIM_STYLES.
	var trim_mesh := _ornate_mesh(kind, body, accent, _trim_variant())
	if trim_mesh.get_surface_count() > 0:
		var trim := MeshInstance3D.new()
		trim.name = "OrnateTrim"
		trim.mesh = trim_mesh
		trim.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
		piece.add_child(trim)
	# Belt and braces: every sub-mesh of a piece carries the body material, so no
	# surface can fall back to the default white StandardMaterial3D if a future
	# part is added as its own node instead of being merged into the trim mesh.
	_apply_piece_materials(piece, body)


## ---------------------------------------------------------------------------
## Ornate trim layer
##
## The sculpted Staunton bodies are plain on purpose; the carving that makes the
## set look crafted lives here. Everything is built from cached primitives and
## then merged into a single ArrayMesh with one surface per material, so a full
## 32-piece set costs 64 trim draw calls. The same ornament set as loose nodes
## would be roughly 600, which is not affordable on a phone.
## ---------------------------------------------------------------------------

const ORNAMENT_BODY := 0
const ORNAMENT_ACCENT := 1


func _radial_segments() -> int:
	match _effective_graphics_quality():
		"low": return 12
		"medium": return 18
	return 24


func _ornament_primitive(shape: String, a: float, b: float, c: float) -> Mesh:
	var key := "orn:%s:%s:%s:%s:%d" % [shape, a, b, c, _radial_segments()]
	if _mesh_cache.has(key):
		return _mesh_cache[key]
	var created: Mesh = null
	match shape:
		"cylinder":
			var cylinder := CylinderMesh.new()
			cylinder.top_radius = a
			cylinder.bottom_radius = b
			cylinder.height = c
			cylinder.radial_segments = _radial_segments()
			cylinder.rings = 2
			created = cylinder
		"sphere":
			var sphere := SphereMesh.new()
			sphere.radius = a
			sphere.height = a * 2.0
			sphere.radial_segments = _radial_segments()
			sphere.rings = maxi(4, _radial_segments() / 2)
			created = sphere
		"torus":
			var torus := TorusMesh.new()
			torus.inner_radius = maxf(0.01, a - b)
			torus.outer_radius = a + b
			torus.rings = _radial_segments()
			torus.ring_segments = 6 if _radial_segments() <= 12 else 8
			created = torus
		"box":
			var box := BoxMesh.new()
			box.size = Vector3(a, b, c)
			created = box
		"cone":
			# A cylinder whose top radius is zero: watertight, and the only way to
			# get a pointed ear out of the primitive set.
			var cone := CylinderMesh.new()
			cone.top_radius = 0.0
			cone.bottom_radius = a
			cone.height = b
			cone.radial_segments = maxi(6, _radial_segments() / 2)
			cone.rings = 1
			created = cone
	_mesh_cache[key] = created
	return created


func _ornament_add(parts: Array, shape: String, a: float, b: float, c: float, position: Vector3, material_index: int, rotation := Vector3.ZERO) -> void:
	var primitive := _ornament_primitive(shape, a, b, c)
	var basis := Basis.IDENTITY
	if rotation != Vector3.ZERO:
		basis = Basis.from_euler(Vector3(deg_to_rad(rotation.x), deg_to_rad(rotation.y), deg_to_rad(rotation.z)))
	parts.append([primitive, Transform3D(basis, position), material_index])


const ORNAMENT_FLUTE_SEGMENTS := 48
## Fluting on the stem is deliberately shallow - 0.008 of amplitude - and only
## on the narrow mid-stem shaft. The base and the head stay smooth.
const ORNAMENT_FLUTE_DEPTH := 0.008
## A flush inlay is 0.015 tall and stands only 0.004 proud of the body profile.
## How much carving each piece theme gets, on top of its colours. The foot of a
## turned Staunton body is the one place where a few per cent of height reads as
## a completely different set, so the two knobs stay per theme even though all
## three shipped sets happen to sit at the plain end of both: a future set can
## step its foot out or add a second pair of rules without touching geometry
## code.
const TRIM_STYLES := {
	# The two sculpted sets bring their own foot, their own crowns and their own
	# carving, so they get no extra silhouette at all - only the two gold rules.
	"medieval": {"foot_scale": 1.00, "extra_bands": false},
	"court": {"foot_scale": 1.00, "extra_bands": false},
	"classic": {"foot_scale": 1.00, "extra_bands": false},
}
const ORNAMENT_BAND_HEIGHT := 0.015
const ORNAMENT_BAND_PROUD := 0.004


## Revolves a 2D profile around the Y axis into two meshes, one per material
## slot. Each ring is [radius, y, hard, gold]: `hard` duplicates the ring so its
## normal splits there, which is what gives a razor-sharp machined crease at a
## base step or a collar disc while the curves between rings stay silky smooth.
## `gold` routes the ring to the second slot, so the trim is a separate material
## on the same mesh rather than a second draw call.
func _lathe_surfaces(profile: Array, segments: int) -> Array:
	var body_v := PackedVector3Array()
	var body_n := PackedVector3Array()
	var body_uv := PackedVector2Array()
	var body_i := PackedInt32Array()
	var gold_v := PackedVector3Array()
	var gold_n := PackedVector3Array()
	var gold_uv := PackedVector2Array()
	var gold_i := PackedInt32Array()
	var ring_count := profile.size()
	var tangents := PackedVector2Array()
	tangents.resize(ring_count)
	for i in ring_count:
		var before := maxi(0, i - 1)
		var after := mini(ring_count - 1, i + 1)
		var delta := Vector2(
			float(profile[after][0]) - float(profile[before][0]),
			float(profile[after][1]) - float(profile[before][1]))
		tangents[i] = delta.normalized() if delta.length() > 0.0001 else Vector2(0.0, 1.0)
	for i in ring_count - 1:
		var a: Array = profile[i]
		var b: Array = profile[i + 1]
		var edge := Vector2(float(b[0]) - float(a[0]), float(b[1]) - float(a[1]))
		edge = edge.normalized() if edge.length() > 0.0001 else Vector2(0.0, 1.0)
		var tangent_a: Vector2 = edge if int(a[2]) == 1 else tangents[i]
		var tangent_b: Vector2 = edge if int(b[2]) == 1 else tangents[i + 1]
		var use_gold := int(a[3]) == 1 or int(b[3]) == 1
		var first: int
		var second: int
		if use_gold:
			first = _lathe_ring_into(gold_v, gold_n, gold_uv, float(a[0]), float(a[1]), tangent_a, segments)
			second = _lathe_ring_into(gold_v, gold_n, gold_uv, float(b[0]), float(b[1]), tangent_b, segments)
		else:
			first = _lathe_ring_into(body_v, body_n, body_uv, float(a[0]), float(a[1]), tangent_a, segments)
			second = _lathe_ring_into(body_v, body_n, body_uv, float(b[0]), float(b[1]), tangent_b, segments)
		var indices: PackedInt32Array = gold_i if use_gold else body_i
		for j in segments:
			var next_j := (j + 1) % segments
			indices.append(first + j)
			indices.append(second + j)
			indices.append(first + next_j)
			indices.append(first + next_j)
			indices.append(second + j)
			indices.append(second + next_j)
	return [
		_lathe_mesh(body_v, body_n, body_uv, body_i),
		_lathe_mesh(gold_v, gold_n, gold_uv, gold_i)
	]


## Appends one revolved ring and returns the index of its first vertex. Packed
## arrays are passed by reference, so the caller's buffers grow in place.
func _lathe_ring_into(vertices: PackedVector3Array, normals: PackedVector3Array, uvs: PackedVector2Array, radius: float, height: float, tangent: Vector2, segments: int) -> int:
	var start: int = vertices.size()
	for j in segments:
		var angle := TAU * float(j) / float(segments)
		# The normal is the profile tangent turned into this ring's radial plane,
		# so it stays perpendicular to the surface however the profile leans.
		var normal := Vector3(tangent.y * cos(angle), -tangent.x, tangent.y * sin(angle))
		vertices.append(Vector3(cos(angle) * radius, height, sin(angle) * radius))
		normals.append(normal.normalized())
		uvs.append(Vector2(float(j) / float(segments), height))
	return start


func _lathe_mesh(vertices: PackedVector3Array, normals: PackedVector3Array, uvs: PackedVector2Array, indices: PackedInt32Array) -> Mesh:
	if vertices.is_empty():
		return null
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = vertices
	arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_TEX_UV] = uvs
	arrays[Mesh.ARRAY_INDEX] = indices
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	return mesh


## An ultra-thin flush inlay: 0.015 tall, standing only 0.004 proud of the body
## profile, revolved as a flat annulus so it reads as machined metal let into
## the wood rather than as a donut ring sitting on top of it. A revolved annulus
## is used rather than a torus because a torus makes height and protrusion the
## same number, and the brief wants them to differ.
func _flush_band(radius: float, height := ORNAMENT_BAND_HEIGHT, proud := ORNAMENT_BAND_PROUD) -> Array:
	# A ridge, not a cylinder wall. The band used to be a flat annulus whose
	# normals pointed straight out sideways, and the key light arrives from above
	# and to the left - so the ring was lit by the fill alone and every "gold"
	# line on every piece rendered as a black scribe mark. Three rings instead of
	# four, with the outer one in the middle: the upper facet tilts up toward the
	# key and catches a real metal highlight, the lower one falls into shade, and
	# the whole thing reads as a machined ring set into the surface rather than a
	# painted stripe. It is the same three vertices, one ring fewer than before.
	var half := height * 0.5
	var outer := radius + proud
	return [
		[radius, -half, 1, 1],
		[outer, 0.0, 1, 1],
		[radius, half, 1, 1]
	]


## A lathe-revolved cylinder whose radius is modulated around its circumference,
## which is what turns a smooth stem into real carved fluting. 48 radial segments
## keeps 16 grooves crisp without ballooning the triangle count.
func _fluted_cylinder_arrays(top_radius: float, bottom_radius: float, height: float, segments: int, flutes: int, depth: float) -> Array:
	var vertices := PackedVector3Array()
	var normals := PackedVector3Array()
	var uvs := PackedVector2Array()
	var indices := PackedInt32Array()
	var half := height * 0.5
	var rings := 6
	# Side wall: one ring of `segments` vertices per height step, wrapping by one
	# so the seam closes. The height fraction and the angle are separate
	# variables here on purpose. The previous version drove both from one `t`,
	# which made the radius pulse from bottom_radius to top_radius once around
	# the piece instead of varying with height, and left only two vertices
	# vertically - so the foot collar was a lumpy ring with no waist of its own
	# rather than a fluted cone.
	for j in rings + 1:
		var t := float(j) / float(rings)
		var y := lerpf(-half, half, t)
		var radius := lerpf(bottom_radius, top_radius, t)
		# dr/dy of a straight cone, so the normal leans the right way.
		var slope := (top_radius - bottom_radius) / maxf(0.001, height)
		for i in segments + 1:
			var angle := TAU * float(i) / float(segments)
			var flute := 1.0 + depth * sin(angle * float(flutes))
			var radial := Vector3(cos(angle), 0.0, sin(angle))
			var normal := (radial + Vector3(0.0, -slope, 0.0)).normalized()
			vertices.append(radial * (radius * flute) + Vector3(0.0, y, 0.0))
			normals.append(normal)
			uvs.append(Vector2(float(i) / float(segments), t))
	for j in rings:
		for i in segments:
			var a := j * (segments + 1) + i
			var b := a + 1
			var c := a + (segments + 1)
			var d := c + 1
			indices.append(a)
			indices.append(c)
			indices.append(b)
			indices.append(b)
			indices.append(c)
			indices.append(d)
	# Caps. The bottom cap faces down, so its winding runs the other way.
	var cap_ys := [-half, half]
	for cap_index in 2:
		var cap_y: float = cap_ys[cap_index]
		var radius: float = bottom_radius if cap_y < 0.0 else top_radius
		var upward := cap_y > 0.0
		var centre := vertices.size()
		vertices.append(Vector3(0.0, cap_y, 0.0))
		normals.append(Vector3(0.0, 1.0 if upward else -1.0, 0.0))
		uvs.append(Vector2(0.5, 0.5))
		var ring_start := vertices.size()
		for i in segments:
			var angle := TAU * float(i) / float(segments)
			var flute := 1.0 + depth * sin(angle * float(flutes))
			vertices.append(Vector3(cos(angle) * radius * flute, cap_y, sin(angle) * radius * flute))
			normals.append(Vector3(0.0, 1.0 if upward else -1.0, 0.0))
			uvs.append(Vector2(0.5 + 0.5 * cos(angle), 0.5 + 0.5 * sin(angle)))
		for i in segments:
			var next := ring_start + ((i + 1) % segments)
			var here := ring_start + i
			if upward:
				indices.append(centre)
				indices.append(here)
				indices.append(next)
			else:
				indices.append(centre)
				indices.append(next)
				indices.append(here)
	# Mesh arrays are indexed by the ARRAY_* constants and are expected to be
	# ARRAY_MAX long; a short four-entry list is rejected outright.
	var result := []
	result.resize(Mesh.ARRAY_MAX)
	result[Mesh.ARRAY_VERTEX] = vertices
	result[Mesh.ARRAY_NORMAL] = normals
	result[Mesh.ARRAY_TEX_UV] = uvs
	result[Mesh.ARRAY_INDEX] = indices
	return result


## Appends a cached fluted lathe to a part list. Used for the lower base collar
## and the stem sleeve, where the brief asks for carved grooves rather than a
## smooth surface.
func _fluted_add(parts: Array, top_radius: float, bottom_radius: float, height: float, position: Vector3, material_index: int, flutes: int, depth: float) -> void:
	var key := "flute:%s:%s:%s:%d:%d:%s" % [top_radius, bottom_radius, height, flutes, ORNAMENT_FLUTE_SEGMENTS, depth]
	if not _mesh_cache.has(key):
		var tool := SurfaceTool.new()
		tool.create_from_arrays(
			_fluted_cylinder_arrays(top_radius, bottom_radius, height, ORNAMENT_FLUTE_SEGMENTS, flutes, depth),
			Mesh.PRIMITIVE_TRIANGLES)
		_mesh_cache[key] = tool.commit()
	parts.append([_mesh_cache[key], Transform3D(Basis.IDENTITY, position), material_index])


## A fluted lathe whose radius is the shipped Staunton silhouette itself,
## sampled off the body mesh, standing a hair proud of it so the fluting reads
## as carving cut into the wood rather than as a sleeve buried inside it.
##
## It used to follow an invented curve that bottomed out at a hardcoded waist
## and flared to the foot radius at both band edges. That curve spent most of
## its height pinned near the waist - pow(away, 1.8) is 0.29 by the time it is
## halfway out - so a pawn's stem was 0.052 across under a 0.261 foot, and the
## knight's was 0.065 under 0.326 where the model says 0.163. Reading the real
## radius off the mesh makes both numbers unreachable as mistakes.
func _turned_stem_arrays(kind: String, low: float, high: float, segments: int, flutes: int, depth: float, scale: float) -> Array:
	var vertices := PackedVector3Array()
	var normals := PackedVector3Array()
	var uvs := PackedVector2Array()
	var indices := PackedInt32Array()
	var span := maxf(0.001, high - low)
	var rings := 16
	for j in rings + 1:
		var t := float(j) / float(rings)
		var y := low + span * t
		var radius := (_body_radius_at(kind, y) + ORNAMENT_BAND_PROUD) * scale
		var slope := _body_slope_at(kind, y)
		for i in segments + 1:
			var angle := TAU * float(i) / float(segments)
			var flute := 1.0 + depth * sin(angle * float(flutes))
			var radial := Vector3(cos(angle), 0.0, sin(angle))
			# Outward normal of a surface of revolution: the radial direction,
			# tilted by the profile slope turned the right way round. dr/dy
			# positive means the surface leans outward going up, so the normal
			# leans down.
			var normal := (radial + Vector3(0.0, -slope, 0.0)).normalized()
			vertices.append(radial * (radius * flute) + Vector3(0.0, y - (low + high) * 0.5, 0.0))
			normals.append(normal)
			uvs.append(Vector2(float(i) / float(segments), t))
	for j in rings:
		for i in segments:
			var a := j * (segments + 1) + i
			var b := a + 1
			var c := a + (segments + 1)
			var d := c + 1
			indices.append(a)
			indices.append(c)
			indices.append(b)
			indices.append(b)
			indices.append(c)
			indices.append(d)
	var result := []
	result.resize(Mesh.ARRAY_MAX)
	result[Mesh.ARRAY_VERTEX] = vertices
	result[Mesh.ARRAY_NORMAL] = normals
	result[Mesh.ARRAY_TEX_UV] = uvs
	result[Mesh.ARRAY_INDEX] = indices
	return result


## Appends the turned stem to a part list, spanning the profile's stem band.
## Cached by kind and band, so the six kinds share nothing, and the lathe follows
## the same foot_scale the foot does so a stepped-out theme stays one surface.
func _turned_stem_add(parts: Array, kind: String, profile: Dictionary, scale: float) -> void:
	var low: float = profile.stem_low
	var high: float = profile.stem_high
	var height: float = high - low
	if height <= 0.001:
		return
	var key := "tstem:%s:%s:%s:%s:%d" % [kind, low, high, scale, ORNAMENT_FLUTE_SEGMENTS]
	if not _mesh_cache.has(key):
		var tool := SurfaceTool.new()
		tool.create_from_arrays(
			_turned_stem_arrays(kind, low, high, ORNAMENT_FLUTE_SEGMENTS,
				profile.flutes, ORNAMENT_FLUTE_DEPTH, scale),
			Mesh.PRIMITIVE_TRIANGLES)
		_mesh_cache[key] = tool.commit()
	parts.append([_mesh_cache[key], Transform3D(Basis.IDENTITY, Vector3(0, low + height * 0.5, 0)), ORNAMENT_BODY])


## Per-kind Staunton proportions, in the same units as the body models
## (pawn 0.91 tall ... king 1.62 tall, foot radius about 0.33).
##
## Every number here is measured off the shipped .obj, not chosen. The earlier
## table invented a waist of 0.052-0.065 for all six kinds, which is a fifth of
## what the models actually are: the pawn's stem narrows to 0.073 of its 0.261
## foot, the bishop's to 0.082 of 0.326. Forcing all six onto one constant is
## what turned every stem into a toothpick and the pawn into a lollipop.
##
## `stem_low` / `stem_high` are the vertical band the turned lathe covers; it is
## the concave part of the silhouette, from just above the foot to just below
## the neck collar. `waist` and `waist_y` locate the narrowest point, which is
## where the second flush inlay sits. `neck` is the radius the body actually
## reaches at `neck_y`, so the collar is sized by the mesh and not by taste.
##
## `turned` says whether the body above the base is a surface of revolution at
## all. It is true for five of the six; the knight is a horse, and its base is
## carved into its own mesh, so it gets one flush inlay and nothing else.
func _ornate_profile(kind: String) -> Dictionary:
	var profile := {
		"foot": 0.261, "stem_low": 0.180, "stem_high": 0.560,
		"waist": 0.073, "waist_y": 0.501,
		"neck": 0.105, "neck_y": 0.660, "flutes": 8,
		# False for the knight, whose body is a horse rather than a turned stem.
		"turned": true
	}
	match kind:
		"rook":
			profile.foot = 0.326; profile.stem_low = 0.236; profile.stem_high = 0.900
			profile.waist = 0.099; profile.waist_y = 0.767
			profile.neck = 0.139; profile.neck_y = 0.800; profile.flutes = 10
		"knight":
			# The knight's base is carved into its own body mesh (see
			# tools/build_knight.py), so the lathe entries above the foot are never
			# read for it. A horse's chest is not a surface of revolution: at the
			# collar height the body is 0.142 across in X but 0.30 deep in Z, so a
			# lathe sized by the widest radius sticks out sideways as a ruff and
			# one sized by the narrowest sinks into the chest.
			profile.foot = 0.326
			profile.turned = false
		"bishop":
			profile.foot = 0.326; profile.stem_low = 0.268; profile.stem_high = 0.900
			profile.waist = 0.082; profile.waist_y = 0.670
			profile.neck = 0.127; profile.neck_y = 0.840; profile.flutes = 8
		"queen":
			profile.foot = 0.326; profile.stem_low = 0.298; profile.stem_high = 0.960
			profile.waist = 0.082; profile.waist_y = 0.820
			profile.neck = 0.121; profile.neck_y = 0.980; profile.flutes = 12
		"king":
			profile.foot = 0.326; profile.stem_low = 0.324; profile.stem_high = 1.020
			profile.waist = 0.085; profile.waist_y = 0.729
			profile.neck = 0.145; profile.neck_y = 1.020; profile.flutes = 12
	# The sculpted set is not a surface of revolution anywhere, so none of the
	# lathe entries above apply to it: it takes the turned=False path, which is
	# just the two gold rules let into the base.
	if _piece_set() != "staunton":
		profile.turned = false
		profile.foot = 0.326
	return profile


func _ornate_mesh(kind: String, body: Material, accent: Material, variant: String) -> ArrayMesh:
	# No facing term any more: the trim is a set of bodies of revolution plus a
	# few crown pieces, so a white and a black pawn share one mesh. The knight,
	# whose head used to be built here facing one way or the other, is now the
	# shipped horse body and is spun as a whole node instead.
	var key := "trim:%s:%s:%d:%d:%d" % [kind, variant, body.get_instance_id(), accent.get_instance_id(), _radial_segments()]
	if _mesh_cache.has(key):
		return _mesh_cache[key]
	var parts: Array = _ornate_trim_parts(kind, variant)
	# The crowns, coronets and battlements are only added for the turned set.
	# The two sculpted sets already have all three carved into their own meshes -
	# the medieval king holds a staff, the court king a sceptre and the court
	# queen wears a crown - so adding this layer on top would put a second crown
	# through the first.
	if variant == "classic":
		_ornate_identity_parts(parts, kind)
	var mesh := ArrayMesh.new()
	for material_index in [ORNAMENT_BODY, ORNAMENT_ACCENT]:
		var tool := SurfaceTool.new()
		tool.begin(Mesh.PRIMITIVE_TRIANGLES)
		var used := false
		for part in parts:
			if int(part[2]) != material_index:
				continue
			tool.append_from(part[0] as Mesh, 0, part[1] as Transform3D)
			used = true
		if used:
			mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, tool.commit_to_arrays())
			mesh.surface_set_material(mesh.get_surface_count() - 1, accent if material_index == ORNAMENT_ACCENT else body)
	_mesh_cache[key] = mesh
	return mesh


## Tiered foot with micro-bevels, a filigree stud band, vertical fluting on the
## stem, a mid-stem brass band and a turned neck collar.
func _ornate_trim_parts(kind: String, variant: String) -> Array:
	var parts: Array = []
	var profile := _ornate_profile(kind)
	var foot: float = profile.foot
	var neck: float = profile.neck
	var neck_y: float = profile.neck_y
	# The sets can be finished differently, not just coloured differently: a theme
	# may ask for a taller, wider turned foot (see TRIM_STYLES), so a set reads as
	# a different object rather than as a recolour of the same one. The stem lathe
	# is scaled by the same factor, or the wider foot would step inward where it
	# meets a classic-width stem.
	var style: Dictionary = TRIM_STYLES.get(variant, TRIM_STYLES["classic"])
	var scale: float = style.foot_scale
	foot *= scale
	var turned := bool(profile.get("turned", true))
	# The knight is not a surface of revolution: its base is carved into its own
	# body mesh by tools/build_knight.py, at exactly the 0.326 the five turned
	# bodies use. A lathe foot of the same size would z-fight with it, and a theme
	# that steps its foot out would leave the knight standing on a disc wider than
	# its own base.
	# It gets the one detail every other piece carries instead: a gold inlay let
	# into the waist of the stem, sized off the body's own radius there (0.191) so
	# it sits flush instead of being buried in the wood.
	if not turned:
		# Both sculpted sets are turned=False: their feet are carved into the body
		# rather than lathed, so the metal they get is a set of gold rules let
		# into the surface rather than a lathed foot. Every radius below is
		# measured from the piece's own mesh (see _set_radius_at), which is what
		# keeps them in the carving: the same two heights land on the plinth rim
		# of a guard and on the flared hem of a queen, and both sit flush.
		#
		# Two rules on the plinth, the way a jewelled base is banded, then a
		# third on the narrowest point between waist and shoulder - the neck of a
		# figure, which is where a collar reads as worn rather than applied.
		# Two rings per figure, both at a *waist* of its own silhouette: the neck
		# between shoulders and head, and the waist between hips and chest. That
		# is deliberate. A band laid at an arbitrary height sits on a surface
		# that is leaning, so the ring either cuts into the piece on the uphill
		# side or floats clear of it on the downhill side - which is exactly what
		# the first attempt did, and it read as a bracelet hovering round the
		# base. At a local minimum of the radius the surface is near-vertical all
		# the way round the ring, so the inlay lands in the carving: a collar at
		# the throat and a belt at the waist, the two places a figure is dressed
		# rather than a place the geometry happens to allow.
		#
		# They are also thicker than the turned set's hairlines - 0.018 tall and
		# 0.006 proud against 0.012 and 0.004 - because a sculpted figure is
		# about 200 pixels wide on the screen the game is played on and a
		# one-pixel gold line simply is not visible there.
		# Two thousandths inside the measured radius, and therefore eight
		# thousandths proud of it: the band's inner edge is always buried in the
		# surface, so an error of a couple of thousandths in the profile - which
		# a 96-bin read of a rounded mesh can have - sinks the ring slightly
		# instead of leaving it hanging in the air. Sunk reads as inlay; floating
		# reads as a mistake.
		# No lathe bands on a sculpted piece, and this is a conclusion rather than
		# an omission. A band here is a circle of revolution, and a sculpted plinth
		# is not round: it is scalloped, with lobes that reach 0.19 and valleys at
		# 0.14. There is no circle that follows that surface - measured from the
		# lobes it floats over every valley, measured from the valleys it buries
		# itself in every lobe, and the first attempts did both, which looked like
		# bangles hanging round the pieces.
		#
		# The metal on the sculpted sets is drawn into the mesh instead: a band of
		# the surface's own vertices is tinted gold in _piece_mesh(). That follows
		# every lobe and every fold, cannot float, cannot z-fight, and costs no
		# triangles at all - which is the only way to put a rule on a carving.
		return parts
	# Tiered foot. The lower collar is a fluted lathe rather than a smooth
	# cylinder, and the fluting is shallow: 0.008 of amplitude over 16 grooves.
	# Nothing here protrudes past the turned profile. Every metal accent on a
	# piece is a flush band let into the shape, never a ring sitting on top of
	# it: the old torus collars and the twelve-bead ring read as a cogwheel
	# around the base.
	_ornament_add(parts, "cylinder", foot * 0.88, foot, 0.05, Vector3(0, 0.025, 0), ORNAMENT_BODY)
	_fluted_add(parts, foot * 0.60, foot * 0.88, 0.055, Vector3(0, 0.082, 0), ORNAMENT_BODY, 16, 0.012)
	# Flush inlays one and two of four, let into the base step as a double rule.
	# Two thin gold lines read as a designed edge where one reads as a seam, and
	# their radii are taken from the body mesh rather than from the foot, so each
	# line sits at the same depth in the wood on all five turned bodies instead of
	# floating on the pawn and sinking into the king.
	_flush_band_add(parts, foot * 0.64, Vector3(0, 0.108, 0))
	_flush_band_add(parts, _body_radius_at(kind, 0.146), Vector3(0, 0.146, 0), 0.010, 0.004)
	# The mid-stem shaft: a turned lathe spanning the stem band, following the
	# radius the body mesh itself reaches at every height. The carving and the
	# silhouette are one surface rather than a sleeve buried in the wood, and the
	# fluting is visible along the whole stem.
	_turned_stem_add(parts, kind, profile, scale)
	# A turned bead above the base step, which is the detail a hand-turned
	# Staunton foot carries and the plainest of the turned bodies otherwise goes
	# without. It is a shallow ribbed lathe following the real silhouette, so it
	# reads as a ring cut into the wood rather than as a hoop pushed over it -
	# the failure mode the torus collars had.
	var bead_y: float = float(profile.stem_low) + 0.055
	var bead_r: float = _body_radius_at(kind, bead_y) + 0.008
	_fluted_add(parts, bead_r, bead_r * 0.96, 0.045, Vector3(0, bead_y, 0), ORNAMENT_BODY, 16, 0.030)
	# Flush inlay three of four, sitting on the narrowest point of the stem.
	_flush_band_add(parts, (profile.waist + 0.004) * scale, Vector3(0, profile.waist_y, 0), 0.010, 0.004)
	# Turned neck collar, with the fourth flush inlay let into it.
	_ornament_add(parts, "cylinder", neck * 0.88, neck, 0.07, Vector3(0, neck_y - 0.045, 0), ORNAMENT_BODY)
	_flush_band_add(parts, neck, Vector3(0, neck_y + 0.015, 0))
	# A theme that sets extra_bands gets a second pair of gold rules bracketing the
	# fluted stem, sized off the body the same way every other band is, so they sit
	# in the wood on the pawn and on the king alike. None of the three shipped
	# sets asks for it; the knob is kept for the next one.
	if bool(style.extra_bands):
		var low_y: float = float(profile.stem_low) + 0.130
		var high_y: float = float(profile.waist_y) - 0.060
		_flush_band_add(parts, _body_radius_at(kind, low_y), Vector3(0, low_y, 0), 0.012, 0.004)
		_flush_band_add(parts, _body_radius_at(kind, high_y), Vector3(0, high_y, 0), 0.012, 0.004)
	return parts


## Appends one flush inlay band to a part list, taking only the gold surface out
## of the lathe so it lands in the trim mesh's gold slot.
func _flush_band_add(parts: Array, radius: float, position: Vector3, height := ORNAMENT_BAND_HEIGHT, proud := ORNAMENT_BAND_PROUD) -> void:
	var key := "band:%s:%s:%s:%d" % [radius, height, proud, ORNAMENT_FLUTE_SEGMENTS]
	if not _mesh_cache.has(key):
		var surfaces := _lathe_surfaces(_flush_band(radius, height, proud), ORNAMENT_FLUTE_SEGMENTS)
		_mesh_cache[key] = surfaces[1]
	parts.append([_mesh_cache[key], Transform3D(Basis.IDENTITY, position), ORNAMENT_ACCENT])


## Piece-specific crowns and caps, replacing the old single-ring accents.
func _ornate_identity_parts(parts: Array, kind: String) -> void:
	match kind:
		"pawn":
			# A classic Staunton pawn is one uninterrupted sphere with a single
			# thin collar at the neck. The old build added a second torus at
			# y = 0.90 - inside the ball's own radius, so it cut a dark groove
			# clean around the head - and a finial nub on top of it. Both are
			# gone; what is left is the ball and the one collar under it.
			_ornament_add(parts, "torus", 0.135, 0.010, 0.0, Vector3(0, 0.72, 0), ORNAMENT_ACCENT)
			_ornament_add(parts, "sphere", 0.115, 0.0, 0.0, Vector3(0, 0.83, 0), ORNAMENT_BODY)
		"rook":
			# Stonework battlements around a flanged crown. One thin metal ring at
			# the neck below the crown and nothing else: the second ring that used
			# to sit on top of the battlements was a wide bright hoop catching the
			# rim light, and together with the crown it read as a white band
			# wrapped round a black piece.
			_ornament_add(parts, "torus", 0.168, 0.009, 0.0, Vector3(0, 0.80, 0), ORNAMENT_ACCENT)
			_ornament_add(parts, "cylinder", 0.225, 0.205, 0.13, Vector3(0, 0.90, 0), ORNAMENT_BODY)
			var merlons := 6 if _radial_segments() <= 12 else 8
			for i in merlons:
				var merlon_angle := PI * 2.0 * float(i) / float(merlons)
				_ornament_add(parts, "box", 0.085, 0.14, 0.085,
					Vector3(cos(merlon_angle) * 0.165, 0.99, sin(merlon_angle) * 0.165), ORNAMENT_BODY)
		"knight":
			# Nothing to add. The head, ears, eyes, nostrils and the scalloped
			# mane are sculpted into the body mesh itself, and the only ornament
			# it needs on top is the inlay at the waist of its base, which
			# _ornate_trim_parts() already adds. The primitive version that used to
			# be assembled here - sphere skull, cone snout, two ear cones, a tube
			# neck - is what the player saw as a plain ball on a stand.
			pass
		"bishop":
			# A real mitre, not a bulb. The shipped bishop body ends in a rounded
			# head, and the old trim dropped a 0.235 sphere on top of it, which is
			# why the piece read as a light bulb: a ball on a stem with a metal ring
			# under it. What makes a bishop recognisable is the tall pointed cap, so
			# that is what is built here - a short drum to swallow the body's own
			# head and then a tall cone to a point at 1.415 - with the gold collar
			# at the joint and a ball on the point.
			#
			# Both halves are primitives rather than one lathe. A lathe would be the
			# natural way to draw it, but a lathe is an open shell and this cap has
			# to read as solid stone from every angle, including the low camera this
			# game uses: a shell seen from slightly below shows its own inner wall
			# through the front face and reads as a cup. Cylinder and cone are
			# closed, so they cannot do that.
			_ornament_add(parts, "torus", 0.170, 0.016, 0.0, Vector3(0, 1.058, 0), ORNAMENT_ACCENT)
			_ornament_add(parts, "cylinder", 0.150, 0.158, 0.085, Vector3(0, 1.098, 0), ORNAMENT_BODY)
			# The cap is two cones rather than one: a straight cone from 0.152 to
			# a point is a party hat, and a mitre swells out of its collar and only
			# then draws in. 0.140 over the first 0.13 and 0.150 over the last 0.16
			# gives the shallow S that reads as carved stone.
			_ornament_add(parts, "cone", 0.150, 0.155, 0.0, Vector3(0, 1.218, 0), ORNAMENT_BODY)
			_ornament_add(parts, "cone", 0.140, 0.140, 0.0, Vector3(0, 1.365, 0), ORNAMENT_BODY)
			_ornament_add(parts, "sphere", 0.034, 0.0, 0.0, Vector3(0, 1.446, 0), ORNAMENT_ACCENT)
		"queen":
			# Multi-pointed coronet of brass balls over a fluted drum.
			_ornament_add(parts, "torus", 0.240, 0.026, 0.0, Vector3(0, 1.05, 0), ORNAMENT_ACCENT)
			_ornament_add(parts, "cylinder", 0.285, 0.19, 0.18, Vector3(0, 1.14, 0), ORNAMENT_BODY)
			var points := 8 if _radial_segments() <= 12 else 12
			for i in points:
				var crown_angle := PI * 2.0 * float(i) / float(points)
				_ornament_add(parts, "sphere", 0.042, 0.0, 0.0,
					Vector3(cos(crown_angle) * 0.215, 1.30, sin(crown_angle) * 0.215), ORNAMENT_ACCENT)
				_ornament_add(parts, "cylinder", 0.012, 0.012, 0.075,
					Vector3(cos(crown_angle) * 0.215, 1.26, sin(crown_angle) * 0.215), ORNAMENT_BODY)
			_ornament_add(parts, "sphere", 0.085, 0.0, 0.0, Vector3(0, 1.36, 0), ORNAMENT_BODY)
			_ornament_add(parts, "torus", 0.090, 0.009, 0.0, Vector3(0, 1.42, 0), ORNAMENT_ACCENT)
		"king":
			# Coronet with a pearl finial and a brass cross on top.
			_ornament_add(parts, "torus", 0.235, 0.028, 0.0, Vector3(0, 1.17, 0), ORNAMENT_ACCENT)
			_ornament_add(parts, "cylinder", 0.185, 0.235, 0.16, Vector3(0, 1.26, 0), ORNAMENT_BODY)
			var crown := 6 if _radial_segments() <= 12 else 8
			for i in crown:
				var king_angle := PI * 2.0 * float(i) / float(crown)
				_ornament_add(parts, "sphere", 0.026, 0.0, 0.0,
					Vector3(cos(king_angle) * 0.185, 1.33, sin(king_angle) * 0.185), ORNAMENT_ACCENT)
			_ornament_add(parts, "sphere", 0.075, 0.0, 0.0, Vector3(0, 1.40, 0), ORNAMENT_ACCENT)
			_ornament_add(parts, "box", 0.05, 0.34, 0.05, Vector3(0, 1.55, 0), ORNAMENT_ACCENT)
			_ornament_add(parts, "box", 0.26, 0.05, 0.05, Vector3(0, 1.60, 0), ORNAMENT_ACCENT)
	# The turned set separates itself from the sculpted ones by its own colours and
	# finish alone - not by an extra protruding collar ring, which is the cogwheel
	# the brief asked to remove.


func _create_ui() -> void:
	# A single restrained sidebar groups secondary controls without competing
	# with the board. It is inserted behind the scene title and all HUD controls.
	var sidebar := PanelContainer.new()
	sidebar.position = Vector2(14, 14)
	sidebar.size = Vector2(208, 572)
	sidebar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	sidebar.add_theme_stylebox_override("panel", _glass_stylebox(14, Color(0.05, 0.06, 0.09, 0.62), Color(0.62, 0.55, 0.42, 0.30)))
	$UI.add_child(sidebar)
	$UI.move_child(sidebar, 0)
	_register_left_column(sidebar)

	_top_panel = HBoxContainer.new()
	var panel := _top_panel
	panel.add_theme_constant_override("separation", 6)
	$UI.add_child(panel)
	panel.set_anchors_preset(Control.PRESET_TOP_RIGHT)

	_status_label = Label.new()
	_status_label.custom_minimum_size = Vector2(196, 44)
	_status_label.add_theme_font_size_override("font_size", 20)
	_status_label.add_theme_color_override("font_color", Color("e8c56a"))
	panel.add_child(_status_label)

	_clock_label = Label.new()
	_clock_label.custom_minimum_size = Vector2(146, 44)
	_clock_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_clock_label.add_theme_font_size_override("font_size", 20)
	_clock_label.add_theme_color_override("font_color", Color(0.90, 0.90, 0.92, 0.94))
	panel.add_child(_clock_label)

	_mode_button = Button.new()
	_mode_button.text = "VS AI" if play_vs_ai else "LOCAL"
	_mode_button.custom_minimum_size = Vector2(76, 42)
	_mode_button.pressed.connect(_toggle_game_mode)
	panel.add_child(_mode_button)

	var clock_button := Button.new()
	clock_button.text = "CLOCK"
	clock_button.custom_minimum_size = Vector2(78, 42)
	clock_button.pressed.connect(_toggle_clock)
	panel.add_child(clock_button)

	var camera_button := Button.new()
	camera_button.text = "VIEW"
	camera_button.custom_minimum_size = Vector2(72, 42)
	camera_button.pressed.connect(_reset_camera)
	panel.add_child(camera_button)

	var haptic_button := Button.new()
	haptic_button.text = "VIBE" if haptics_enabled else "VIBE OFF"
	haptic_button.custom_minimum_size = Vector2(68, 42)
	haptic_button.pressed.connect(_toggle_haptics.bind(haptic_button))
	panel.add_child(haptic_button)

	var undo_button := Button.new()
	undo_button.text = "UNDO"
	undo_button.custom_minimum_size = Vector2(78, 42)
	undo_button.pressed.connect(_undo)
	panel.add_child(undo_button)

	var new_button := Button.new()
	new_button.text = "NEW"
	new_button.custom_minimum_size = Vector2(78, 42)
	new_button.pressed.connect(_new_game)
	panel.add_child(new_button)

	var menu_button := Button.new()
	menu_button.text = "MENU"
	menu_button.custom_minimum_size = Vector2(76, 42)
	menu_button.pressed.connect(_show_main_menu)
	panel.add_child(menu_button)

	_graphics_button = Button.new()
	_graphics_button.position = Vector2(28, 66)
	_graphics_button.size = Vector2(112, 36)
	_graphics_button.pressed.connect(_cycle_graphics_quality)
	$UI.add_child(_graphics_button)
	_register_left_column(_graphics_button)
	_update_graphics_button()

	_sound_button = Button.new()
	_sound_button.position = Vector2(28, 108)
	_sound_button.size = Vector2(112, 36)
	_sound_button.pressed.connect(_toggle_sound)
	$UI.add_child(_sound_button)
	_register_left_column(_sound_button)
	_update_sound_button()

	_music_button = Button.new()
	_music_button.position = Vector2(28, 150)
	_music_button.size = Vector2(112, 36)
	_music_button.pressed.connect(_toggle_music)
	$UI.add_child(_music_button)
	_register_left_column(_music_button)
	_update_music_button()

	for child in panel.get_children():
		if child is Button:
			_style_hud_button(child)
	for button in [_graphics_button, _sound_button, _music_button]:
		_style_hud_button(button)

	_fps_label = Label.new()
	_fps_label.set_anchors_preset(Control.PRESET_BOTTOM_RIGHT)
	_fps_label.offset_left = -145.0
	_fps_label.offset_top = -48.0
	_fps_label.offset_right = -20.0
	_fps_label.offset_bottom = -18.0
	_fps_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	_fps_label.add_theme_color_override("font_color", Color(0.68, 0.74, 0.82, 0.90))
	_fps_label.add_theme_font_size_override("font_size", 15)
	# Named so the automated capture harness can hide it: on the software
	# renderer CI uses, the very first frames land about a second apart, so the
	# readout froze on "1 FPS" and that is what ended up in the screenshot.
	_fps_label.name = "PerformanceReadout"
	$UI.add_child(_fps_label)
	_create_main_menu()
	_create_game_panels()


func _style_hud_button(button: Button) -> void:
	# Glassmorphic: a translucent dark fill, a hairline border that catches the
	# warm key light, and a gold accent on hover and press. Without the explicit
	# styleboxes a themed Button falls back to the default project theme, which
	# is opaque and ignores these colours entirely.
	var normal := _glass_stylebox(8, Color(0.07, 0.08, 0.11, 0.60), Color(0.58, 0.60, 0.68, 0.42))
	var active := _glass_stylebox(8, Color(0.17, 0.13, 0.09, 0.78), Color("d4af37"))
	button.add_theme_stylebox_override("normal", normal)
	button.add_theme_stylebox_override("hover", active)
	button.add_theme_stylebox_override("pressed", active)
	button.add_theme_stylebox_override("focus", active)
	button.add_theme_stylebox_override("disabled", normal)
	button.add_theme_color_override("font_color", Color(0.93, 0.92, 0.88, 0.96))
	button.add_theme_color_override("font_hover_color", Color("f6e7c4"))
